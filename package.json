{
  "name": "psite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "serve": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:unit": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/unit/heroAnimationLifecycle.test.ts tests/unit/heroAnimationRunState.test.ts tests/unit/heroNetwork.test.ts tests/unit/heroPointerInteraction.test.ts",
    "test:generated": "node tests/static/verify-generated.mjs && node tests/static/verify-glitch-keyframes.mjs",
    "test:smoke": "npm run generate && npm run test:generated && npm run test:smoke:generated",
    "test:smoke:generated": "playwright test tests/e2e/smoke.spec.ts",
    "validate": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run generate && npm run test:generated && npm run test:smoke:generated"
  },
  "dependencies": {
    "animate.css": "4.1.1",
    "nuxt": "4.6.0",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "sass": "1.80.4",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.12"
  }
}
